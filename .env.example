# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://backend.your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,https://admin.your-domain.com,http://localhost:5173,http://localhost:5174

# Auth & Security (REQUIRED — server will NOT start without these)
ADMIN_SECRET_KEY=
ADMIN_PASSWORD=
PASSWORD_SALT=
MAINTENANCE_PASSWORD=
CUSTOMER_JWT_SECRET=
ADMIN_EMAIL=admin@your-domain.com

# Razorpay (REQUIRED)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MySQL Database
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Shiprocket Logistics
SHIPROCKET_EMAIL=
SHIPROCKET_API_KEY=
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_DEFAULT_PICKUP_PINCODE=400001

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Your Store Name
SMTP_FROM_EMAIL=

# Store Info
SUPPORT_EMAIL=
SUPPORT_PHONE=
INSTAGRAM_URL=
FACEBOOK_URL=
YOUTUBE_URL=
WHATSAPP_NUMBER=
STORE_GSTIN=
STORE_STATE=
STORE_ADDRESS=
STORE_PHONE=
STORE_PHONE_RAW=
STORE_WHATSAPP=
STORE_EMAIL=
