# Application Configuration
PORT=5000

# Maintenance & Coming Soon Gatekeeper Configuration
# Set MAINTENANCE_MODE=true to block direct visitors and show Coming Soon / Maintenance Screen.
# Set MAINTENANCE_MODE=false to allow public access.
MAINTENANCE_MODE=true
MAINTENANCE_PASSWORD=valuelife2026

# Frontend API URL Configuration (Vite)
# For Hostinger preview dummy domain use:
VITE_API_URL=https://darkturquoise-penguin-872547.hostingersite.com
# For local testing use: http://localhost:5000

# Database Configuration (Hostinger MySQL or Local SQLite)
# Set DB_TYPE=mysql to use Hostinger Free MySQL Database. Leave blank or set DB_TYPE=sqlite for local SQLite.
DB_TYPE=sqlite

# Hostinger Free MySQL Credentials (Required only when DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_USER=u123456789_dbname
MYSQL_PASSWORD=YourStrongDatabasePassword123!
MYSQL_DATABASE=u123456789_dbname
MYSQL_PORT=3306
